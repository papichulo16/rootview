   'data': { '*vnet_hdr_support': 'bool' } }
 
+##
+# @IntrospectionProperties:
+#
+# Properties for introspection objects (KVMI).
+#
+# @chardev: socket chardev connected to the introspection tool
+#
+# @key: id of a secret whose SHA-1 the tool must send back
+#
+# @handshake-timeout: seconds to wait for the tool's handshake
+#     (default: 10)
+#
+# Since: 11.0
+##
+{ 'struct': 'IntrospectionProperties',
+  'data': { 'chardev': 'str',
+            '*key': 'str',
+            '*handshake-timeout': 'uint32' },
+  'if': 'CONFIG_LINUX' }
+
 ##
 # @InputBarrierProperties:
 #
@@ -1216,6 +1236,8 @@
     { 'name': 'igvm-cfg',
       'if': 'CONFIG_IGVM' },
     'input-barrier',
+    { 'name': 'introspection',
+      'if': 'CONFIG_LINUX' },
     { 'name': 'input-linux',
       'if': 'CONFIG_LINUX' },
     'iommufd',
@@ -1294,6 +1316,8 @@
       'igvm-cfg':                   { 'type': 'IgvmCfgProperties',
                                       'if': 'CONFIG_IGVM' },
       'input-barrier':              'InputBarrierProperties',
+      'introspection':              { 'type': 'IntrospectionProperties',
+                                      'if': 'CONFIG_LINUX' },
