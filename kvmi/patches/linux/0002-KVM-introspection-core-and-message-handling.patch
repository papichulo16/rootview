+
+/* Called before KVM injects events, so a queued exception goes in now. */
+void kvmi_enter_guest(struct kvm_vcpu *vcpu)
+{
+	struct kvm_vcpu_introspection *vcpui;
+	struct kvm_introspection *kvmi;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return;
+
+	vcpui = VCPUI(vcpu);
+
+	if (vcpui->exception.pending && !vcpui->singlestep.loop &&
+	    !vcpui->singlestep.owner && kvmi_arch_queue_exception(vcpu)) {
+		vcpui->exception.pending = false;
+		vcpui->exception.send_event = true;
+		kvm_make_request(KVM_REQ_EVENT, vcpu);
+	}
+
+	kvmi_put(vcpu->kvm);
+}
+
+bool kvmi_vcpu_pending_event(struct kvm_vcpu *vcpu)
+{
+	struct kvm_introspection *kvmi;
+	bool ret;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return false;
+
+	ret = VCPUI(vcpu)->exception.send_event;
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+
+u8 kvmi_gfn_allowed_access(struct kvm *kvm, gfn_t gfn)
+{
+	struct kvm_introspection *kvmi;
+	u8 access = KVMI_FULL_ACCESS;
+	void *entry;
+
+	if (!READ_ONCE(kvm->kvmi))
+		return access;
+
+	kvmi = kvmi_get(kvm);
+	if (!kvmi)
+		return access;
+
+	if (atomic_read(&kvmi->nr_restricted)) {
+		entry = xa_load(&kvmi->access, gfn);
+		if (entry)
+			access = xa_to_value(entry);
+	}
+
+	kvmi_put(kvm);
+
+	return access;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_gfn_allowed_access);
+
+bool kvmi_gfn_range_restricted(struct kvm *kvm, gfn_t start, gfn_t end)
+{
+	struct kvm_introspection *kvmi;
+	unsigned long index = start;
+	bool ret = false;
+
+	if (!READ_ONCE(kvm->kvmi))
+		return false;
+
+	kvmi = kvmi_get(kvm);
+	if (!kvmi)
+		return false;
+
+	if (atomic_read(&kvmi->nr_restricted))
+		ret = !!xa_find(&kvmi->access, &index, end - 1, XA_PRESENT);
+
+	kvmi_put(kvm);
+
+	return ret;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_gfn_range_restricted);
+
+static u8 kvmi_get_gfn_access(struct kvm_introspection *kvmi, gfn_t gfn)
+{
+	void *entry = xa_load(&kvmi->access, gfn);
+
+	return entry ? xa_to_value(entry) : KVMI_FULL_ACCESS;
+}
+
+static int kvmi_set_gfn_access(struct kvm_introspection *kvmi, gfn_t gfn,
+			       u8 access)
+{
+	u8 old;
+	int err = 0;
+
+	access &= KVMI_FULL_ACCESS;
+
+	mutex_lock(&kvmi->access_lock);
+
+	old = kvmi_get_gfn_access(kvmi, gfn);
+	if (old == access)
+		goto out;
+
+	if (access == KVMI_FULL_ACCESS) {
+		xa_erase(&kvmi->access, gfn);
+		atomic_dec(&kvmi->nr_restricted);
+	} else {
+		err = xa_err(xa_store(&kvmi->access, gfn, xa_mk_value(access),
+				      GFP_KERNEL_ACCOUNT));
+		if (err)
+			goto out;
+		if (old == KVMI_FULL_ACCESS)
+			atomic_inc(&kvmi->nr_restricted);
+	}
+
+	kvmi_arch_zap_gfn(kvmi->kvm, gfn);
+
+out:
+	mutex_unlock(&kvmi->access_lock);
+	return err ? -KVM_ENOMEM : 0;
+}
+
+int kvmi_cmd_set_page_access(struct kvm_introspection *kvmi, u64 gpa,
+			     u8 access)
+{
+	return kvmi_set_gfn_access(kvmi, gpa_to_gfn(gpa), access);
+}
+
+static bool kvmi_restricted_access(struct kvm_introspection *kvmi, gpa_t gpa,
+				   u8 access)
+{
+	u8 allowed = kvmi_get_gfn_access(kvmi, gpa_to_gfn(gpa));
+
+	/*
+	 * We want to be notified only for violations involving access
+	 * bits that we've specifically cleared
+	 */
+	return !!((~allowed) & access);
+}
+
+/*
+ * The custom input is defined by a virtual address and size, and all reads
+ * must be within this space. Reads that are completely outside should be
+ * satisfyied using guest memory. Overlapping reads are erroneous.
+ */
+static int use_custom_input(struct kvm_vcpu *vcpu, gva_t gva, u8 *new,
+			    int bytes)
+{
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	struct kvmi_custom_ro_data *c = &vcpui->custom_ro_data;
+	unsigned int offset;
+
+	if (!c->size || !bytes)
+		return 0;
+
+	if (bytes < 0 || bytes > c->size) {
+		kvmi_warn_once(KVMI(vcpu->kvm),
+			       "%s: invalid range %d max %zu\n",
+			       __func__, bytes, c->size);
+		return 0;
+	}
+
+	if (gva + bytes <= c->addr || gva >= c->addr + c->size)
+		return 0;
+
+	if (gva < c->addr || gva + bytes > c->addr + c->size) {
+		kvmi_warn_once(KVMI(vcpu->kvm),
+			       "%s: read ranges overlap: 0x%lx:%d, 0x%lx:%zu\n",
+			       __func__, gva, bytes, c->addr, c->size);
+		return 0;
+	}
+
+	offset = gva - c->addr;
+
+	memcpy(new, c->data + offset, bytes);
+
+	return bytes;
+}
+
+static bool __kvmi_track_preread(struct kvm_vcpu *vcpu, gpa_t gpa, gva_t gva,
+				 u8 *new, int bytes, bool *data_ready)
+{
+	bool ret;
+
+	if (!kvmi_restricted_access(KVMI(vcpu->kvm), gpa, KVMI_PAGE_ACCESS_R))
+		return true;
+
+	if (use_custom_input(vcpu, gva, new, bytes))
+		goto out_custom;
+
+	ret = kvmi_arch_pf_event(vcpu, gpa, gva, KVMI_PAGE_ACCESS_R);
+
+	if (ret && use_custom_input(vcpu, gva, new, bytes))
+		goto out_custom;
+
+	return ret;
+
+out_custom:
+	*data_ready = true;
+	return true;
+}
+
+bool kvmi_page_track_preread(struct kvm_vcpu *vcpu, gpa_t gpa, gva_t gva,
+			     u8 *new, int bytes, bool *data_ready)
+{
+	struct kvm_introspection *kvmi;
+	bool ret = true;
+
+	*data_ready = false;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return true;
+
+	if (is_event_enabled(vcpu, KVMI_EVENT_PF))
+		ret = __kvmi_track_preread(vcpu, gpa, gva, new, bytes,
+					   data_ready);
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+
+static bool kvmi_track_access(struct kvm_vcpu *vcpu, gpa_t gpa, gva_t gva,
+			      u8 access)
+{
+	struct kvm_introspection *kvmi;
+	bool ret = true;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return true;
+
+	if (is_event_enabled(vcpu, KVMI_EVENT_PF) &&
+	    kvmi_restricted_access(kvmi, gpa, access))
+		ret = kvmi_arch_pf_event(vcpu, gpa, gva, access);
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+
+bool kvmi_page_track_prewrite(struct kvm_vcpu *vcpu, gpa_t gpa, gva_t gva)
+{
+	return kvmi_track_access(vcpu, gpa, gva, KVMI_PAGE_ACCESS_W);
+}
+
+bool kvmi_page_track_preexec(struct kvm_vcpu *vcpu, gpa_t gpa, gva_t gva)
+{
+	return kvmi_track_access(vcpu, gpa, gva, KVMI_PAGE_ACCESS_X);
+}
+
+bool kvmi_vcpu_running_singlestep(struct kvm_vcpu *vcpu)
+{
+	struct kvm_introspection *kvmi;
+	bool ret;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return false;
+
+	ret = VCPUI(vcpu)->singlestep.loop || VCPUI(vcpu)->singlestep.owner;
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_vcpu_running_singlestep);
+
+static u32 kvmi_send_singlestep(struct kvm_vcpu *vcpu, bool success)
+{
+	struct kvmi_event_singlestep e;
+	int err, action;
+
+	memset(&e, 0, sizeof(e));
+	e.failed = success ? 0 : 1;
+
+	err = kvmi_send_event(vcpu, KVMI_EVENT_SINGLESTEP, &e, sizeof(e),
+			      NULL, 0, &action);
+	if (err)
+		return KVMI_EVENT_ACTION_CONTINUE;
+
+	return action;
+}
+
+static void kvmi_singlestep_event(struct kvm_vcpu *vcpu, bool success)
+{
+	u32 action;
+
+	if (!is_event_enabled(vcpu, KVMI_EVENT_SINGLESTEP))
+		return;
+
+	action = kvmi_send_singlestep(vcpu, success);
+	if (action != KVMI_EVENT_ACTION_CONTINUE)
+		kvmi_handle_common_event_actions(vcpu->kvm, action,
+						 "SINGLESTEP");
+}
+
+static void restore_original_content(struct kvm_vcpu *vcpu)
+{
+	struct kvm_introspection *kvmi = KVMI(vcpu->kvm);
+	size_t bytes = kvmi->singlestep.custom_ro_data.size;
+
+	if (!bytes)
+		return;
+
+	kvmi_arch_write_guest_virt(vcpu, VCPUI(vcpu)->custom_ro_data.addr,
+				   kvmi->singlestep.custom_ro_data.data, bytes);
+
+	kvmi->singlestep.custom_ro_data.size = 0;
+}
+
+static void kvmi_stop_singlestep_insn(struct kvm_vcpu *vcpu)
+{
+	struct kvm_introspection *kvmi = KVMI(vcpu->kvm);
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	int l;
+
+	for (l = kvmi->singlestep.level; l--;)
+		kvmi_set_gfn_access(kvmi, kvmi->singlestep.backup[l].gfn,
+				    kvmi->singlestep.backup[l].old_access);
+
+	kvmi->singlestep.level = 0;
+
+	restore_original_content(vcpu);
+
+	atomic_set(&kvmi->singlestep.active, false);
+	/*
+	 * Make the singlestep.active update visible
+	 * before resuming all the other vCPUs.
+	 */
+	smp_mb__after_atomic();
+	kvm_make_all_cpus_request(vcpu->kvm, KVM_REQ_INTROSPECTION);
+
+	vcpui->singlestep.owner = false;
+
+	if (!vcpui->singlestep.loop)
+		kvmi_arch_stop_singlestep(vcpu);
+}
+
+/*
+ * This function is called (a) if the introspection tool has set the vCPU
+ * in single-step mode with KVMI_VCPU_CONTROL_SINGLESTEP (singlestep.loop)
+ * or (b) if the vCPU is single-stepped transparently for the introspection
+ * tool due to a unimplemented instruction (singlestep.owner).
+ */
+static void kvmi_handle_singlestep_exit(struct kvm_vcpu *vcpu, bool success)
+{
+	struct kvm_vcpu_introspection *vcpui;
+	struct kvm_introspection *kvmi;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return;
+
+	vcpui = VCPUI(vcpu);
+
+	if (vcpui->singlestep.owner)
+		kvmi_stop_singlestep_insn(vcpu);
+	if (vcpui->singlestep.loop)
+		kvmi_singlestep_event(vcpu, success);
+
+	kvmi_put(vcpu->kvm);
+}
+
+void kvmi_singlestep_done(struct kvm_vcpu *vcpu)
+{
+	kvmi_handle_singlestep_exit(vcpu, true);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_singlestep_done);
+
+void kvmi_singlestep_failed(struct kvm_vcpu *vcpu)
+{
+	kvmi_handle_singlestep_exit(vcpu, false);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_singlestep_failed);
+
+void kvmi_init_emulate(struct kvm_vcpu *vcpu)
+{
+	struct kvm_vcpu_introspection *vcpui;
+	struct kvm_introspection *kvmi;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return;
+
+	vcpui = VCPUI(vcpu);
+
+	vcpui->rep_complete = false;
+	vcpui->effective_rep_complete = false;
+
+	vcpui->custom_ro_data.size = 0;
+	vcpui->custom_ro_data.addr = 0;
+
+	kvmi_put(vcpu->kvm);
+}
+
+/*
+ * If the user has requested that events triggered by repetitive
+ * instructions be suppressed after the first cycle, then this
+ * function will effectively activate it. This ensures that we don't
+ * prematurely suppress potential events (second or later) triggered
+ * by an instruction during a single pass.
+ */
+void kvmi_activate_rep_complete(struct kvm_vcpu *vcpu)
+{
+	struct kvm_introspection *kvmi;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return;
+
+	VCPUI(vcpu)->effective_rep_complete = VCPUI(vcpu)->rep_complete;
+
+	kvmi_put(vcpu->kvm);
+}
+
+static bool kvmi_acquire_singlestep_insn(struct kvm_vcpu *vcpu)
+{
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	struct kvm_introspection *kvmi = KVMI(vcpu->kvm);
+
+	if (vcpui->singlestep.owner)
+		return true;
+
+	if (atomic_cmpxchg(&kvmi->singlestep.active, false, true) != false)
+		return false;
+
+	kvm_make_all_cpus_request(vcpu->kvm,
+				  KVM_REQ_INTROSPECTION | KVM_REQUEST_WAIT);
+
+	vcpui->singlestep.owner = true;
+	kvmi->singlestep.custom_ro_data.size = 0;
+
+	return true;
+}
+
+static int write_custom_data(struct kvm_vcpu *vcpu)
+{
+	struct kvm_introspection *kvmi = KVMI(vcpu->kvm);
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	size_t bytes = vcpui->custom_ro_data.size;
+	gva_t gva = vcpui->custom_ro_data.addr;
+
+	if (kvmi->singlestep.custom_ro_data.size || !bytes)
+		return 0;
+
+	if (kvmi_arch_read_guest_virt(vcpu, gva,
+				      kvmi->singlestep.custom_ro_data.data,
+				      bytes))
+		return -KVM_EINVAL;
+
+	if (kvmi_arch_write_guest_virt(vcpu, gva, vcpui->custom_ro_data.data,
+				       bytes))
+		return -KVM_EINVAL;
+
+	kvmi->singlestep.custom_ro_data.size = bytes;
+
+	return 0;
+}
+
+static bool kvmi_run_singlestep_insn(struct kvm_vcpu *vcpu, gpa_t gpa,
+				     u8 access)
+{
+	struct kvm_introspection *kvmi = KVMI(vcpu->kvm);
+	u8 l = kvmi->singlestep.level;
+	gfn_t gfn = gpa_to_gfn(gpa);
+	u8 old_access, new_access;
+	int err;
+
+	if (!kvmi_arch_start_singlestep(vcpu))
+		return false;
+
+	err = write_custom_data(vcpu);
+	if (err) {
+		kvmi_err(kvmi, "writing custom data failed, err %d\n", err);
+		return false;
+	}
+
+	old_access = kvmi_get_gfn_access(kvmi, gfn);
+	if (old_access == KVMI_FULL_ACCESS)
+		return true;
+
+	if (l == SINGLESTEP_MAX_DEPTH - 1) {
+		kvmi_err(kvmi, "singlestep limit reached\n");
+		return false;
+	}
+
+	kvmi->singlestep.backup[l].gfn = gfn;
+	kvmi->singlestep.backup[l].old_access = old_access;
+	kvmi->singlestep.level++;
+
+	new_access = kvmi_arch_relax_page_access(old_access, access);
+
+	kvmi_set_gfn_access(kvmi, gfn, new_access);
+
+	return true;
+}
+
+static bool kvmi_start_singlestep_insn(struct kvm_vcpu *vcpu, gpa_t gpa,
+				       u8 access)
+{
+	bool ret;
+
+	while (!kvmi_acquire_singlestep_insn(vcpu)) {
+		int err = kvmi_wait_singlestep_insn(vcpu);
+
+		if (err) {
+			kvmi_err(KVMI(vcpu->kvm), "kvmi_wait_singlestep_insn() has failed\n");
+			return false;
+		}
+	}
+
+	ret = kvmi_run_singlestep_insn(vcpu, gpa, access);
+	if (!ret)
+		kvmi_stop_singlestep_insn(vcpu);
+
+	return ret;
+}
+
+static bool __kvmi_singlestep_insn(struct kvm_vcpu *vcpu, gpa_t gpa,
+				   int *emulation_type)
+{
+	struct kvm_introspection *kvmi = KVMI(vcpu->kvm);
+	u8 access = kvmi_arch_pf_access(vcpu);
+
+	if (kvmi_arch_invalid_insn(vcpu, emulation_type))
+		return false;
+
+	if (kvmi_get_gfn_access(kvmi, gpa_to_gfn(gpa)) == KVMI_FULL_ACCESS)
+		return false;
+
+	/*
+	 * The emulator never got to the access, so report it from the fault
+	 * (SVM gives no linear address) before running the instruction.
+	 */
+	if (is_event_enabled(vcpu, KVMI_EVENT_PF) &&
+	    kvmi_restricted_access(kvmi, gpa, access) &&
+	    !kvmi_arch_pf_event(vcpu, gpa, 0, access))
+		return true;
+
+	return kvmi_start_singlestep_insn(vcpu, gpa, access);
+}
+
+bool kvmi_singlestep_insn(struct kvm_vcpu *vcpu, gpa_t gpa, int *emulation_type)
+{
+	struct kvm_introspection *kvmi;
+	bool ret;
+
+	kvmi = kvmi_vcpu_get(vcpu);
+	if (!kvmi)
+		return false;
+
+	ret = __kvmi_singlestep_insn(vcpu, gpa, emulation_type);
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
