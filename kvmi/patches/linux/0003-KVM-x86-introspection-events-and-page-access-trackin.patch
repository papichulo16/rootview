 int emulator_task_switch(struct x86_emulate_ctxt *ctxt,
diff --git a/arch/x86/kvm/kvmi.c b/arch/x86/kvm/kvmi.c
new file mode 100644
index 0000000..ebcc3af
--- /dev/null
+++ b/arch/x86/kvm/kvmi.c
@@ -0,0 +1,940 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KVM introspection - x86
+ *
+ * Copyright (C) 2019-2020 Bitdefender S.R.L.
+ * Ported to Linux 7.3 for rootview.
+ */
+
+#include <linux/kvm_host.h>
+#include "x86.h"
+#include "regs.h"
+#include "cpuid.h"
+#include "mmu.h"
+#include "../../../virt/kvm/introspection/kvmi_int.h"
+
+static unsigned int kvmi_vcpu_mode(struct kvm_vcpu *vcpu,
+				   const struct kvm_sregs *sregs)
+{
+	if (is_long_mode(vcpu) && sregs->cs.l)
+		return 8;
+	return sregs->cs.db ? 4 : 2;
+}
+
+/*
+ * Host-initiated reads run from inside KVM_RUN here, which SVM's PAT
+ * handling warns about, so take the guest's PAT straight from KVM.
+ */
+static int kvmi_read_msr(struct kvm_vcpu *vcpu, u32 index, u64 *data)
+{
+	if (index == MSR_IA32_CR_PAT) {
+		*data = vcpu->arch.pat;
+		return 0;
+	}
+
+	return kvm_msr_read(vcpu, index, data);
+}
+
+static u64 kvmi_msr(struct kvm_vcpu *vcpu, u32 index)
+{
+	u64 data = 0;
+
+	kvmi_read_msr(vcpu, index, &data);
+	return data;
+}
+
+static void kvmi_get_msrs(struct kvm_vcpu *vcpu, struct kvmi_event_arch *event)
+{
+	event->msrs.sysenter_cs = kvmi_msr(vcpu, MSR_IA32_SYSENTER_CS);
+	event->msrs.sysenter_esp = kvmi_msr(vcpu, MSR_IA32_SYSENTER_ESP);
+	event->msrs.sysenter_eip = kvmi_msr(vcpu, MSR_IA32_SYSENTER_EIP);
+	event->msrs.efer = kvmi_msr(vcpu, MSR_EFER);
+	event->msrs.star = kvmi_msr(vcpu, MSR_STAR);
+	event->msrs.lstar = kvmi_msr(vcpu, MSR_LSTAR);
+	event->msrs.cstar = kvmi_msr(vcpu, MSR_CSTAR);
+	event->msrs.pat = kvmi_msr(vcpu, MSR_IA32_CR_PAT);
+	event->msrs.shadow_gs = kvmi_msr(vcpu, MSR_KERNEL_GS_BASE);
+}
+
+void kvmi_arch_setup_event(struct kvm_vcpu *vcpu, struct kvmi_event *ev)
+{
+	struct kvmi_event_arch *event = &ev->arch;
+
+	kvm_arch_vcpu_get_regs(vcpu, &event->regs);
+	kvm_arch_vcpu_get_sregs(vcpu, &event->sregs);
+	event->mode = kvmi_vcpu_mode(vcpu, &event->sregs);
+	kvmi_get_msrs(vcpu, event);
+	event->view = 0;
+}
+
+int kvmi_arch_cmd_vcpu_get_info(struct kvm_vcpu *vcpu,
+				struct kvmi_vcpu_get_info_reply *rpl)
+{
+	if (kvm_caps.has_tsc_control)
+		rpl->tsc_speed = 1000ul * vcpu->arch.virtual_tsc_khz;
+	else
+		rpl->tsc_speed = 0;
+
+	return 0;
+}
+
+static void *
+alloc_get_registers_reply(const struct kvmi_vcpu_get_registers *req,
+			  size_t *rpl_size)
+{
+	struct kvmi_vcpu_get_registers_reply *rpl;
+	u16 k, n = req->nmsrs;
+
+	*rpl_size = struct_size(rpl, msrs.entries, n);
+	rpl = kvmi_msg_alloc_check(*rpl_size);
+	if (rpl) {
+		rpl->msrs.nmsrs = n;
+
+		for (k = 0; k < n; k++)
+			rpl->msrs.entries[k].index = req->msrs_idx[k];
+	}
+
+	return rpl;
+}
+
+static int kvmi_get_registers(struct kvm_vcpu *vcpu, u32 *mode,
+			      struct kvm_regs *regs,
+			      struct kvm_sregs *sregs,
+			      struct kvm_msrs *msrs)
+{
+	struct kvm_msr_entry *msr = msrs->entries;
+	struct kvm_msr_entry *end = msrs->entries + msrs->nmsrs;
+
+	kvm_arch_vcpu_get_regs(vcpu, regs);
+	kvm_arch_vcpu_get_sregs(vcpu, sregs);
+	*mode = kvmi_vcpu_mode(vcpu, sregs);
+
+	for (; msr < end; msr++) {
+		u64 data;
+
+		if (kvmi_read_msr(vcpu, msr->index, &data))
+			return -KVM_EINVAL;
+
+		msr->data = data;
+	}
+
+	return 0;
+}
+
+int kvmi_arch_cmd_vcpu_get_registers(struct kvm_vcpu *vcpu,
+				const struct kvmi_msg_hdr *msg,
+				const struct kvmi_vcpu_get_registers *req,
+				struct kvmi_vcpu_get_registers_reply **dest,
+				size_t *dest_size)
+{
+	struct kvmi_vcpu_get_registers_reply *rpl;
+	size_t rpl_size = 0;
+
+	if (req->padding1 || req->padding2)
+		return -KVM_EINVAL;
+
+	if (msg->size < sizeof(struct kvmi_vcpu_hdr)
+			+ struct_size(req, msrs_idx, req->nmsrs))
+		return -KVM_EINVAL;
+
+	rpl = alloc_get_registers_reply(req, &rpl_size);
+	if (!rpl)
+		return -KVM_ENOMEM;
+
+	*dest = rpl;
+	*dest_size = rpl_size;
+
+	return kvmi_get_registers(vcpu, &rpl->mode, &rpl->regs,
+				  &rpl->sregs, &rpl->msrs);
+}
+
+int kvmi_arch_cmd_vcpu_get_cpuid(struct kvm_vcpu *vcpu,
+				 const struct kvmi_vcpu_get_cpuid *req,
+				 struct kvmi_vcpu_get_cpuid_reply *rpl)
+{
+	struct kvm_cpuid_entry2 *e;
+
+	e = kvm_find_cpuid_entry_index(vcpu, req->function, req->index);
+	if (!e)
+		return -KVM_ENOENT;
+
+	rpl->eax = e->eax;
+	rpl->ebx = e->ebx;
+	rpl->ecx = e->ecx;
+	rpl->edx = e->edx;
+
+	return 0;
+}
+
+bool kvmi_arch_is_agent_hypercall(struct kvm_vcpu *vcpu)
+{
+	unsigned long subfunc1, subfunc2;
+
+	if (is_64_bit_mode(vcpu)) {
+		subfunc1 = kvm_rdi_read(vcpu);
+		subfunc2 = kvm_rsi_read(vcpu);
+	} else {
+		subfunc1 = kvm_rbx_read(vcpu) & 0xFFFFFFFF;
+		subfunc2 = kvm_rcx_read(vcpu) & 0xFFFFFFFF;
+	}
+
+	return (subfunc1 == KVM_HC_XEN_HVM_OP_GUEST_REQUEST_VM_EVENT
+		&& subfunc2 == 0);
+}
+
+void kvmi_arch_hypercall_event(struct kvm_vcpu *vcpu)
+{
+	u32 action;
+
+	action = kvmi_msg_send_hypercall(vcpu);
+	if (action != KVMI_EVENT_ACTION_CONTINUE)
+		kvmi_handle_common_event_actions(vcpu->kvm, action,
+						 "HYPERCALL");
+}
+
+static void kvmi_control_bp(struct kvm_vcpu *vcpu, bool enable)
+{
+	WRITE_ONCE(vcpu->arch.kvmi.bp, enable);
+	kvm_x86_call(update_exception_bitmap)(vcpu);
+}
+
+static void kvmi_control_cr3w(struct kvm_vcpu *vcpu, bool enable)
+{
+	WRITE_ONCE(vcpu->arch.kvmi.cr3w, enable);
+	kvm_x86_call(kvmi_control_cr3w)(vcpu, enable);
+}
+
+static int kvmi_control_desc(struct kvm_vcpu *vcpu, bool enable)
+{
+	WRITE_ONCE(vcpu->arch.kvmi.desc, enable);
+	if (kvm_x86_call(kvmi_control_desc)(vcpu, enable))
+		return 0;
+
+	WRITE_ONCE(vcpu->arch.kvmi.desc, false);
+	return enable ? -KVM_EOPNOTSUPP : 0;
+}
+
+static unsigned long *msrw_mask(struct kvm_vcpu *vcpu, u32 *msr)
+{
+	switch (*msr) {
+	case 0 ... 0x1fff:
+		return vcpu->arch.kvmi.msrw_low;
+	case 0xc0000000 ... 0xc0001fff:
+		*msr &= 0x1fff;
+		return vcpu->arch.kvmi.msrw_high;
+	}
+
+	return NULL;
+}
+
+bool kvmi_msrw_intercepted(struct kvm_vcpu *vcpu, u32 msr)
+{
+	unsigned long *mask = msrw_mask(vcpu, &msr);
+
+	return mask && test_bit(msr, mask);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_msrw_intercepted);
+
+static void kvmi_control_msrw(struct kvm_vcpu *vcpu, u32 msr, bool enable)
+{
+	u32 bit = msr;
+	unsigned long *mask = msrw_mask(vcpu, &bit);
+
+	if (!mask)
+		return;
+
+	if (enable)
+		set_bit(bit, mask);
+	else
+		clear_bit(bit, mask);
+
+	kvm_x86_call(kvmi_control_msrw)(vcpu, msr, enable);
+}
+
+int kvmi_arch_cmd_control_intercept(struct kvm_vcpu *vcpu,
+				    unsigned int event_id, bool enable)
+{
+	switch (event_id) {
+	case KVMI_EVENT_BREAKPOINT:
+		kvmi_control_bp(vcpu, enable);
+		return 0;
+	case KVMI_EVENT_DESCRIPTOR:
+		return kvmi_control_desc(vcpu, enable);
+	default:
+		return 0;
+	}
+}
+
+void kvmi_arch_breakpoint_event(struct kvm_vcpu *vcpu, u64 gva, u8 insn_len)
+{
+	u32 action;
+	u64 gpa;
+
+	gpa = kvm_mmu_gva_to_gpa_system(vcpu, gva, NULL);
+
+	action = kvmi_msg_send_bp(vcpu, gpa, insn_len);
+	switch (action) {
+	case KVMI_EVENT_ACTION_CONTINUE:
+		kvm_queue_exception(vcpu, BP_VECTOR);
+		break;
+	case KVMI_EVENT_ACTION_RETRY:
+		/* rip was most likely adjusted past the INT 3 instruction */
+		break;
+	default:
+		kvmi_handle_common_event_actions(vcpu->kvm, action, "BP");
+	}
+}
+
+void kvmi_arch_vcpu_unhook(struct kvm_vcpu *vcpu)
+{
+	WRITE_ONCE(vcpu->arch.kvmi.restore, true);
+}
+
+/* Runs on the vCPU thread once the introspection tool is gone. */
+void kvmi_arch_restore_interception(struct kvm_vcpu *vcpu)
+{
+	struct kvmi_vcpu_intercept *i = &vcpu->arch.kvmi;
+
+	if (i->bp)
+		kvmi_control_bp(vcpu, false);
+	if (i->cr3w)
+		kvmi_control_cr3w(vcpu, false);
+	if (i->desc)
+		kvmi_control_desc(vcpu, false);
+	if (i->singlestep)
+		kvmi_arch_stop_singlestep(vcpu);
+
+	bitmap_zero(i->msrw_low, KVMI_NUM_MSR);
+	bitmap_zero(i->msrw_high, KVMI_NUM_MSR);
+	kvm_make_request(KVM_REQ_RECALC_INTERCEPTS, vcpu);
+
+	WRITE_ONCE(i->restore, false);
+}
+
+int kvmi_arch_cmd_vcpu_control_cr(struct kvm_vcpu *vcpu,
+				  const struct kvmi_vcpu_control_cr *req)
+{
+	u32 cr = req->cr;
+
+	if (req->padding1 || req->padding2 || cr >= KVMI_NUM_CR)
+		return -KVM_EINVAL;
+
+	switch (cr) {
+	case 0:
+	case 4:
+		break;
+	case 3:
+		kvmi_control_cr3w(vcpu, req->enable);
+		break;
+	default:
+		return -KVM_EINVAL;
+	}
+
+	if (req->enable)
+		set_bit(cr, VCPUI(vcpu)->arch.cr_mask);
+	else
+		clear_bit(cr, VCPUI(vcpu)->arch.cr_mask);
+
+	return 0;
+}
+
+static u32 kvmi_send_cr(struct kvm_vcpu *vcpu, u32 cr, u64 old_value,
+			u64 new_value, u64 *ret_value)
+{
+	struct kvmi_event_cr e = {
+		.cr = cr,
+		.old_value = old_value,
+		.new_value = new_value
+	};
+	struct kvmi_event_cr_reply r;
+	int err, action;
+
+	err = kvmi_send_event(vcpu, KVMI_EVENT_CR, &e, sizeof(e),
+			      &r, sizeof(r), &action);
+	if (err) {
+		*ret_value = new_value;
+		return KVMI_EVENT_ACTION_CONTINUE;
+	}
+
+	*ret_value = r.new_val;
+	return action;
+}
+
+static bool __kvmi_cr_event(struct kvm_vcpu *vcpu, unsigned int cr,
+			    unsigned long old_value, unsigned long *new_value)
+{
+	u64 ret_value;
+	u32 action;
+
+	if (!test_bit(cr, VCPUI(vcpu)->arch.cr_mask))
+		return true;
+
+	action = kvmi_send_cr(vcpu, cr, old_value, *new_value, &ret_value);
+	if (action == KVMI_EVENT_ACTION_CONTINUE) {
+		*new_value = ret_value;
+		return true;
+	}
+
+	kvmi_handle_common_event_actions(vcpu->kvm, action, "CR");
+	return false;
+}
+
+bool kvmi_cr_event(struct kvm_vcpu *vcpu, unsigned int cr,
+		   unsigned long old_value, unsigned long *new_value)
+{
+	struct kvm_introspection *kvmi;
+	bool ret = true;
+
+	if (old_value == *new_value || !READ_ONCE(vcpu->kvmi))
+		return true;
+
+	kvmi = kvmi_get(vcpu->kvm);
+	if (!kvmi)
+		return true;
+
+	if (VCPUI(vcpu) && is_event_enabled(vcpu, KVMI_EVENT_CR))
+		ret = __kvmi_cr_event(vcpu, cr, old_value, new_value);
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+
+static u32 kvmi_send_cpuid(struct kvm_vcpu *vcpu, u8 insn_len,
+			   unsigned int function, unsigned int index)
+{
+	struct kvmi_event_cpuid e = {
+		.function = function,
+		.index = index,
+		.insn_length = insn_len
+	};
+	int err, action;
+
+	err = kvmi_send_event(vcpu, KVMI_EVENT_CPUID, &e, sizeof(e),
+			      NULL, 0, &action);
+	if (err)
+		return KVMI_EVENT_ACTION_CONTINUE;
+
+	return action;
+}
+
+bool kvmi_cpuid_event(struct kvm_vcpu *vcpu, u8 insn_len,
+		      unsigned int function, unsigned int index)
+{
+	struct kvm_introspection *kvmi;
+	bool ret = true;
+	u32 action;
+
+	if (!READ_ONCE(vcpu->kvmi))
+		return true;
+
+	kvmi = kvmi_get(vcpu->kvm);
+	if (!kvmi)
+		return true;
+
+	if (VCPUI(vcpu) && is_event_enabled(vcpu, KVMI_EVENT_CPUID)) {
+		if (!insn_len)
+			insn_len = kvm_x86_call(kvmi_insn_len)(vcpu) ?: 2;
+
+		action = kvmi_send_cpuid(vcpu, insn_len, function, index);
+		if (action != KVMI_EVENT_ACTION_CONTINUE) {
+			if (action != KVMI_EVENT_ACTION_RETRY)
+				kvmi_handle_common_event_actions(vcpu->kvm,
+								 action,
+								 "CPUID");
+			ret = false;
+		}
+	}
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+
+int kvmi_arch_cmd_vcpu_inject_exception(struct kvm_vcpu *vcpu, u8 vector,
+					u32 error_code, u64 address)
+{
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	bool has_error = x86_exception_has_error_code(vector);
+
+	if (vcpui->exception.pending || vcpui->exception.send_event)
+		return -KVM_EBUSY;
+
+	vcpui->exception.pending = true;
+
+	vcpui->exception.nr = vector;
+	vcpui->exception.error_code = has_error ? error_code : 0;
+	vcpui->exception.error_code_valid = has_error;
+	vcpui->exception.address = address;
+
+	kvm_make_request(KVM_REQ_INTROSPECTION, vcpu);
+
+	return 0;
+}
+
+static u32 kvmi_send_trap(struct kvm_vcpu *vcpu, u8 vector,
+			  u32 error_code, u64 cr2)
+{
+	struct kvmi_event_trap e = {
+		.vector = vector,
+		.error_code = error_code,
+		.cr2 = cr2
+	};
+	int err, action;
+
+	err = kvmi_send_event(vcpu, KVMI_EVENT_TRAP, &e, sizeof(e),
+			      NULL, 0, &action);
+	if (err)
+		return KVMI_EVENT_ACTION_CONTINUE;
+
+	return action;
+}
+
+void kvmi_arch_trap_event(struct kvm_vcpu *vcpu)
+{
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	u32 action;
+
+	if (!is_event_enabled(vcpu, KVMI_EVENT_TRAP))
+		return;
+
+	action = kvmi_send_trap(vcpu, vcpui->exception.nr,
+				vcpui->exception.error_code,
+				vcpui->exception.address);
+	if (action != KVMI_EVENT_ACTION_CONTINUE)
+		kvmi_handle_common_event_actions(vcpu->kvm, action, "TRAP");
+}
+
+/* Returns false if KVM has an event to reinject first. */
+bool kvmi_arch_queue_exception(struct kvm_vcpu *vcpu)
+{
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	struct x86_exception e = {
+		.vector = vcpui->exception.nr,
+		.error_code_valid = vcpui->exception.error_code_valid,
+		.error_code = vcpui->exception.error_code,
+		.address = vcpui->exception.address,
+	};
+
+	if (kvm_event_needs_reinjection(vcpu))
+		return false;
+
+	if (e.vector == PF_VECTOR)
+		kvm_inject_page_fault(vcpu, &e, false);
+	else if (e.error_code_valid)
+		kvm_queue_exception_e(vcpu, e.vector, e.error_code);
+	else
+		kvm_queue_exception(vcpu, e.vector);
+
+	return true;
+}
+
+static u32 kvmi_send_xsetbv(struct kvm_vcpu *vcpu)
+{
+	int err, action;
+
+	err = kvmi_send_event(vcpu, KVMI_EVENT_XSETBV, NULL, 0,
+			      NULL, 0, &action);
+	if (err)
+		return KVMI_EVENT_ACTION_CONTINUE;
+
+	return action;
+}
+
+void kvmi_xsetbv_event(struct kvm_vcpu *vcpu)
+{
+	struct kvm_introspection *kvmi;
+	u32 action;
+
+	if (!READ_ONCE(vcpu->kvmi))
+		return;
+
+	kvmi = kvmi_get(vcpu->kvm);
+	if (!kvmi)
+		return;
+
+	if (VCPUI(vcpu) && is_event_enabled(vcpu, KVMI_EVENT_XSETBV)) {
+		action = kvmi_send_xsetbv(vcpu);
+		if (action != KVMI_EVENT_ACTION_CONTINUE)
+			kvmi_handle_common_event_actions(vcpu->kvm, action,
+							 "XSETBV");
+	}
+
+	kvmi_put(vcpu->kvm);
+}
+
+int kvmi_arch_cmd_vcpu_get_xsave(struct kvm_vcpu *vcpu,
+				 struct kvmi_vcpu_get_xsave_reply **dest,
+				 size_t *dest_size)
+{
+	struct kvmi_vcpu_get_xsave_reply *rpl = NULL;
+	size_t rpl_size = sizeof(*rpl) + sizeof(struct kvm_xsave);
+
+	rpl = kvmi_msg_alloc_check(rpl_size);
+	if (!rpl)
+		return -KVM_ENOMEM;
+
+	kvm_vcpu_get_xsave(vcpu, (struct kvm_xsave *)&rpl->region[0]);
+
+	*dest = rpl;
+	*dest_size = rpl_size;
+
+	return 0;
+}
+
+int kvmi_arch_cmd_set_xsave(struct kvm_vcpu *vcpu,
+			    const struct kvmi_vcpu_set_xsave *req,
+			    size_t req_size)
+{
+	struct kvm_xsave *area;
+	int err;
+
+	if (req_size > sizeof(*area))
+		return -KVM_EINVAL;
+
+	area = kzalloc(sizeof(*area), GFP_KERNEL_ACCOUNT);
+	if (!area)
+		return -KVM_ENOMEM;
+
+	memcpy(area, req, req_size);
+
+	err = kvm_vcpu_set_xsave(vcpu, area);
+	kfree(area);
+
+	return err ? -KVM_EINVAL : 0;
+}
+
+/* KVM no longer virtualizes guest MTRRs; guest memory is write-back. */
+int kvmi_arch_cmd_vcpu_get_mtrr_type(struct kvm_vcpu *vcpu, u64 gpa, u8 *type)
+{
+	*type = MTRR_TYPE_WRBACK;
+
+	return 0;
+}
+
+static u32 kvmi_msg_send_descriptor(struct kvm_vcpu *vcpu, u8 descriptor,
+				    u8 write)
+{
+	struct kvmi_event_descriptor e;
+	int err, action;
+
+	memset(&e, 0, sizeof(e));
+	e.descriptor = descriptor;
+	e.write = write;
+
+	err = kvmi_send_event(vcpu, KVMI_EVENT_DESCRIPTOR, &e, sizeof(e),
+			      NULL, 0, &action);
+	if (err)
+		return KVMI_EVENT_ACTION_CONTINUE;
+
+	return action;
+}
+
+bool kvmi_descriptor_event(struct kvm_vcpu *vcpu, u8 descriptor, u8 write)
+{
+	struct kvm_introspection *kvmi;
+	bool ret = true;
+	u32 action;
+
+	if (!READ_ONCE(vcpu->kvmi))
+		return true;
+
+	kvmi = kvmi_get(vcpu->kvm);
+	if (!kvmi)
+		return true;
+
+	if (VCPUI(vcpu) && is_event_enabled(vcpu, KVMI_EVENT_DESCRIPTOR)) {
+		action = kvmi_msg_send_descriptor(vcpu, descriptor, write);
+		if (action == KVMI_EVENT_ACTION_RETRY)
+			ret = false;
+		else if (action != KVMI_EVENT_ACTION_CONTINUE)
+			kvmi_handle_common_event_actions(vcpu->kvm, action,
+							 "DESC");
+	}
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_descriptor_event);
+
+static bool kvmi_msr_valid(unsigned int msr)
+{
+	return msr <= 0x1fff || (msr >= 0xc0000000 && msr <= 0xc0001fff);
+}
+
+int kvmi_arch_cmd_vcpu_control_msr(struct kvm_vcpu *vcpu,
+				   const struct kvmi_vcpu_control_msr *req)
+{
+	if (req->padding1 || req->padding2)
+		return -KVM_EINVAL;
+
+	if (!kvmi_msr_valid(req->msr))
+		return -KVM_EINVAL;
+
+	kvmi_control_msrw(vcpu, req->msr, req->enable);
+
+	return 0;
+}
+
+static u32 kvmi_send_msr(struct kvm_vcpu *vcpu, u32 msr, u64 old_value,
+			 u64 new_value, u64 *ret_value)
+{
+	struct kvmi_event_msr e = {
+		.msr = msr,
+		.old_value = old_value,
+		.new_value = new_value,
+	};
+	struct kvmi_event_msr_reply r;
+	int err, action;
+
+	err = kvmi_send_event(vcpu, KVMI_EVENT_MSR, &e, sizeof(e),
+			      &r, sizeof(r), &action);
+	if (err) {
+		*ret_value = new_value;
+		return KVMI_EVENT_ACTION_CONTINUE;
+	}
+
+	*ret_value = r.new_val;
+	return action;
+}
+
+static bool __kvmi_msr_event(struct kvm_vcpu *vcpu, struct msr_data *msr)
+{
+	u64 old_value, ret_value;
+	u32 action;
+
+	if (!kvmi_msrw_intercepted(vcpu, msr->index))
+		return true;
+	if (kvmi_read_msr(vcpu, msr->index, &old_value))
+		return true;
+	if (old_value == msr->data)
+		return true;
+
+	action = kvmi_send_msr(vcpu, msr->index, old_value, msr->data,
+			       &ret_value);
+	if (action == KVMI_EVENT_ACTION_CONTINUE) {
+		msr->data = ret_value;
+		return true;
+	}
+
+	kvmi_handle_common_event_actions(vcpu->kvm, action, "MSR");
+	return false;
+}
+
+bool kvmi_msr_event(struct kvm_vcpu *vcpu, struct msr_data *msr)
+{
+	struct kvm_introspection *kvmi;
+	bool ret = true;
+
+	if (!READ_ONCE(vcpu->kvmi))
+		return true;
+
+	kvmi = kvmi_get(vcpu->kvm);
+	if (!kvmi)
+		return true;
+
+	if (VCPUI(vcpu) && is_event_enabled(vcpu, KVMI_EVENT_MSR))
+		ret = __kvmi_msr_event(vcpu, msr);
+
+	kvmi_put(vcpu->kvm);
+
+	return ret;
+}
+
+int kvmi_arch_cmd_set_page_access(struct kvm_introspection *kvmi,
+				  const struct kvmi_msg_hdr *msg,
+				  const struct kvmi_vm_set_page_access *req)
+{
+	const struct kvmi_page_access_entry *entry = req->entries;
+	const struct kvmi_page_access_entry *end = req->entries + req->count;
+	u8 unknown_bits = ~KVMI_FULL_ACCESS;
+	int ec = 0;
+
+	if (req->padding)
+		return -KVM_EINVAL;
+
+	if (msg->size < struct_size(req, entries, req->count))
+		return -KVM_EINVAL;
+
+	if (req->view != 0)
+		return -KVM_EOPNOTSUPP;
+
+	for (; entry < end; entry++) {
+		int r;
+
+		if ((entry->access & unknown_bits) || entry->padding1
+				|| entry->padding2 || entry->padding3)
+			r = -KVM_EINVAL;
+		else
+			r = kvmi_cmd_set_page_access(kvmi, entry->gpa,
+						     entry->access);
+		if (r) {
+			kvmi_warn(kvmi, "%s: %llx %x padding %x,%x,%x",
+				  __func__, entry->gpa, entry->access,
+				  entry->padding1, entry->padding2,
+				  entry->padding3);
+			if (!ec)
+				ec = r;
+		}
+	}
+
+	return ec;
+}
+
+bool kvmi_arch_pf_event(struct kvm_vcpu *vcpu, gpa_t gpa, gva_t gva,
+			u8 access)
+{
+	struct kvm_vcpu_introspection *vcpui = VCPUI(vcpu);
+	u32 ctx_size;
+	u64 ctx_addr;
+	u32 action;
+
+	if (vcpui->effective_rep_complete)
+		return true;
+
+	ctx_size = sizeof(vcpui->custom_ro_data.data);
+
+	action = kvmi_msg_send_pf(vcpu, gpa, gva, access,
+				  &vcpui->rep_complete, &ctx_addr,
+				  vcpui->custom_ro_data.data, &ctx_size);
+
+	switch (action) {
+	case KVMI_EVENT_ACTION_CONTINUE:
+		vcpui->custom_ro_data.size = ctx_size;
+		vcpui->custom_ro_data.addr = ctx_addr;
+		return true;
+	case KVMI_EVENT_ACTION_RETRY:
+		return false;
+	default:
+		kvmi_handle_common_event_actions(vcpu->kvm, action, "PF");
+		return false;
+	}
+}
+
+void kvmi_arch_features(struct kvm *kvm, struct kvmi_features *feat)
+{
+	feat->singlestep = !!kvm_x86_ops.kvmi_control_singlestep;
+	feat->vmfunc = 0;
+	feat->eptp = 0;
+	feat->ve = 0;
+	feat->spp = 0;
+}
+
+bool kvmi_arch_start_singlestep(struct kvm_vcpu *vcpu)
+{
+	if (!kvm_x86_call(kvmi_control_singlestep)(vcpu, true))
+		return false;
+
+	WRITE_ONCE(vcpu->arch.kvmi.singlestep, true);
+	return true;
+}
+
+bool kvmi_arch_stop_singlestep(struct kvm_vcpu *vcpu)
+{
+	if (!kvm_x86_ops.kvmi_control_singlestep)
+		return false;
+
+	WRITE_ONCE(vcpu->arch.kvmi.singlestep, false);
+	kvm_x86_call(kvmi_control_singlestep)(vcpu, false);
+	kvm_make_request(KVM_REQ_EVENT, vcpu);
+	return true;
+}
+
+/* Deferred so the event is never sent from inside the emulator. */
+void kvmi_arch_singlestep_complete(struct kvm_vcpu *vcpu)
+{
+	WRITE_ONCE(vcpu->arch.kvmi.ss_done, true);
+	kvm_make_request(KVM_REQ_INTROSPECTION, vcpu);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvmi_arch_singlestep_complete);
+
+bool kvmi_arch_singlestep_completed(struct kvm_vcpu *vcpu)
+{
+	if (!READ_ONCE(vcpu->arch.kvmi.ss_done))
+		return false;
+
+	WRITE_ONCE(vcpu->arch.kvmi.ss_done, false);
+	return true;
+}
+
+gpa_t kvmi_arch_cmd_translate_gva(struct kvm_vcpu *vcpu, gva_t gva)
+{
+	return kvm_mmu_gva_to_gpa_system(vcpu, gva, NULL);
+}
+
+bool kvmi_arch_invalid_insn(struct kvm_vcpu *vcpu, int *emulation_type)
+{
+	static const u8 ud2[] = {0x0F, 0x0B};
+	struct x86_emulate_ctxt *ctxt = vcpu->arch.emulate_ctxt;
+	u8 insn_len = ctxt->fetch.ptr - ctxt->fetch.data;
+
+	if (insn_len != sizeof(ud2))
+		return false;
+
+	if (memcmp(ctxt->fetch.data, ud2, insn_len))
+		return false;
+
+	/*
+	 * Do not reexecute the UD2 instruction, else we might enter to an
+	 * endless emulation loop. Let the emulator fall down through the
+	 * handle_emulation_failure() which shall inject the #UD exception.
+	 */
+	*emulation_type &= ~EMULTYPE_ALLOW_RETRY_PF;
+
+	return true;
+}
+
+u8 kvmi_arch_relax_page_access(u8 old, u8 new)
+{
+	u8 ret = old | new;
+
+	/*
+	 * An SPTE entry with just the -wx bits set can trigger a
+	 * misconfiguration error from the hardware, as it's the case
+	 * for x86 where this access mode is used to mark I/O memory.
+	 * Thus, we make sure that -wx accesses are translated to rwx.
+	 */
+	if ((ret & (KVMI_PAGE_ACCESS_W | KVMI_PAGE_ACCESS_X)) ==
+	    (KVMI_PAGE_ACCESS_W | KVMI_PAGE_ACCESS_X))
+		ret |= KVMI_PAGE_ACCESS_R;
+
+	return ret;
+}
+
+u8 kvmi_arch_pf_access(struct kvm_vcpu *vcpu)
+{
+	u64 error_code = vcpu->arch.kvmi.pf_error_code;
+
+	if (error_code & PFERR_FETCH_MASK)
+		return KVMI_PAGE_ACCESS_X;
+	if (error_code & PFERR_WRITE_MASK)
+		return KVMI_PAGE_ACCESS_W;
+	return KVMI_PAGE_ACCESS_R;
+}
+
+void kvmi_arch_zap_gfn(struct kvm *kvm, gfn_t gfn)
+{
+	kvm_zap_gfn_range(kvm, gfn, gfn + 1);
+}
+
+u64 kvmi_arch_cmd_get_xcr(struct kvm_vcpu *vcpu, u8 xcr)
+{
+	return vcpu->arch.xcr0;
+}
+
+int kvmi_arch_read_guest_virt(struct kvm_vcpu *vcpu, gva_t gva, void *data,
+			      unsigned int bytes)
+{
+	struct x86_exception e;
+
+	return kvm_read_guest_virt(vcpu, gva, data, bytes, &e);
+}
+
+int kvmi_arch_write_guest_virt(struct kvm_vcpu *vcpu, gva_t gva, void *data,
+			       unsigned int bytes)
+{
+	struct x86_exception e;
+
+	return kvm_write_guest_virt_system(vcpu, gva, data, bytes, &e);
+}
