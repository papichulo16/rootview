@@ -3437,6 +3437,15 @@ int kvm_mmu_max_mapping_level(struct kvm *kvm, struct kvm_page_fault *fault,
 			break;
 	}
 
+	/* A huge page would hide the restrictions of the 4K pages under it. */
+	for ( ; max_level > PG_LEVEL_4K; max_level--) {
+		gfn_t base = gfn_round_for_level(gfn, max_level);
+
+		if (!kvmi_gfn_range_restricted(kvm, base,
+					       base + KVM_PAGES_PER_HPAGE(max_level)))
+			break;
+	}
+
 	if (max_level == PG_LEVEL_4K)
 		return PG_LEVEL_4K;
 
@@ -4557,6 +4566,33 @@ static int handle_mmio_page_fault(struct kvm_vcpu *vcpu, u64 addr, bool direct)
 	return RET_PF_RETRY;
 }
 
+/*
+ * Accesses the introspection tool restricted are emulated so the emulator
+ * can report them. NPT can't map a page without read access, so a gfn
+ * that lost R is never mapped and every access to it is emulated.
+ */
+static bool kvmi_page_fault_restricted(struct kvm_vcpu *vcpu,
+				       struct kvm_page_fault *fault)
+{
+#ifdef CONFIG_KVM_INTROSPECTION
+	u8 allowed;
+
+	if (fault->rsvd || !fault->slot)
+		return false;
+
+	allowed = kvmi_gfn_allowed_access(vcpu->kvm, fault->gfn);
+	if ((allowed & KVMI_PAGE_ACCESS_R) &&
+	    (!fault->write || (allowed & KVMI_PAGE_ACCESS_W)) &&
+	    (!fault->exec || (allowed & KVMI_PAGE_ACCESS_X)))
+		return false;
+
+	vcpu->arch.kvmi.pf_error_code = fault->error_code;
+	return true;
+#else
+	return false;
+#endif
+}
+
 static bool page_fault_handle_page_track(struct kvm_vcpu *vcpu,
 					 struct kvm_page_fault *fault)
 {
@@ -4851,6 +4887,9 @@ static int direct_page_fault(struct kvm_vcpu *vcpu, struct kvm_page_fault *fault
 	if (WARN_ON_ONCE(kvm_mmu_is_dummy_root(vcpu->arch.mmu->root.hpa)))
 		return RET_PF_RETRY;
 
+	if (kvmi_page_fault_restricted(vcpu, fault))
+		return RET_PF_EMULATE;
+
 	if (page_fault_handle_page_track(vcpu, fault))
 		return RET_PF_WRITE_PROTECTED;
 
@@ -4943,6 +4982,9 @@ static int kvm_tdp_mmu_page_fault(struct kvm_vcpu *vcpu,
 {
 	int r;
 
+	if (kvmi_page_fault_restricted(vcpu, fault))
+		return RET_PF_EMULATE;
+
 	if (page_fault_handle_page_track(vcpu, fault))
 		return RET_PF_WRITE_PROTECTED;
 
